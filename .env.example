# Variables d'environnement d'EcomPilot AI — MODÈLE, sans aucune valeur.
#
# Ce fichier documente ce que le code lit réellement (relevé exhaustif de
# `process.env.*` et `import.meta.env.*` dans `src/`). Il ne contient aucun
# secret et n'est pas chargé à l'exécution.
#
# OÙ METTRE QUOI
#   - Les valeurs marquées SECRET vont dans les secrets du projet (Lovable
#     Cloud). Elles ne doivent JAMAIS être écrites dans `.env`, qui est suivi
#     par git : tout ce qu'on y met part dans l'historique du dépôt.
#   - Pour un essai en local, utiliser `.env.local`, déjà ignoré par git via
#     la règle `*.local` du `.gitignore`.

# --- Application -------------------------------------------------------------

# URL publique de l'application, telle que le navigateur la voit, sans barre
# finale (ex. https://mon-app.exemple.com).
#
# C'est la source du `redirect_uri` OAuth. Sans elle, l'application retombe sur
# les en-têtes du proxy, puis sur `Host` ; derrière Lovable Cloud / Cloudflare
# ces valeurs peuvent porter l'origine INTERNE, et le `redirect_uri` envoyé au
# partenaire ne correspond alors à aucune URL de redirection autorisée.
#
# La valeur doit être identique, au caractère près, au préfixe des URL de
# redirection déclarées chez Shopify, Meta et Google.
APP_URL=

# --- Supabase ----------------------------------------------------------------

# Valeurs publiques : destinées au navigateur, pas des secrets.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# SECRET — contourne entièrement les politiques RLS. Utilisée par
# `supabaseAdmin` (src/integrations/supabase/client.server.ts), notamment dans
# les callbacks OAuth qui écrivent sans session utilisateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Chiffrement et OAuth ----------------------------------------------------

# SECRET — clé de chiffrement des jetons partenaires stockés en base
# (AES-256-GCM, src/lib/crypto.server.ts). La changer rend illisibles tous les
# jetons déjà enregistrés : les boutiques connectées devront être reconnectées.
DATA_CONNECTIONS_ENCRYPTION_KEY=

# SECRET — clé de signature du paramètre `state` OAuth. C'est ce qui empêche un
# tiers de fabriquer un retour d'autorisation. La changer invalide les
# connexions en cours (le `state` expire de toute façon en 15 minutes).
OAUTH_STATE_SECRET=

# --- Shopify -----------------------------------------------------------------
# URL de redirection à déclarer dans l'app Shopify (Partner Dashboard) :
#   <APP_URL>/api/public/oauth/shopify/callback
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Meta Ads ----------------------------------------------------------------
# URL de redirection à déclarer : <APP_URL>/api/public/oauth/meta/callback
META_CLIENT_ID=
META_CLIENT_SECRET=

# --- Google Ads --------------------------------------------------------------
# URL de redirection à déclarer : <APP_URL>/api/public/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SECRET — jeton développeur Google Ads (en-tête `developer-token`).
GOOGLE_ADS_DEVELOPER_TOKEN=

# Identifiant du compte administrateur (MCC) émetteur des appels, chiffres
# seuls, sans tirets. Facultatif : n'est envoyé que s'il est renseigné.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- IA ----------------------------------------------------------------------

# SECRET — clé de la passerelle Lovable AI, utilisée pour les audits
# (google/gemini-2.5-pro) et la préparation des corrections
# (google/gemini-2.5-flash).
LOVABLE_API_KEY=
